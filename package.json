    "remove:undefined-from-fullnames": "ts-node -r tsconfig-paths/register scripts/remove-undefined-from-fullnames.ts",
    "sync:zoom-meetings": "ts-node -r tsconfig-paths/register scripts/sync-zoom-meetings.ts",
    "sync:waba-templates": "ts-node -r tsconfig-paths/register scripts/sync-waba-templates.ts"
