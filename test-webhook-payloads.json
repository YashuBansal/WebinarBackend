  "notes": {
    "usage": "Replace YOUR_PROJECT_ID in the URL with an actual MongoDB ObjectId",
    "testing_idempotency": "Send the same payload multiple times to test duplicate detection. The deduplication ID will be logged in the console.",
    "important_fields": [
      "event - The event type (required)",
      "event_ts - Timestamp in milliseconds (used for deduplication)",
      "payload.object.id - Meeting/Webinar ID (used for deduplication)",
      "payload.object.registrant.email - For registration events (used for deduplication)",
      "payload.object.participant.email - For participant events (used for deduplication)"
    ]
